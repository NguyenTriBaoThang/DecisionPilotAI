# Local Docker demo credentials. Set a different password when using a shared host.
POSTGRES_USER=decisionpilot
POSTGRES_PASSWORD=decisionpilot_local
POSTGRES_DB=decisionpilot
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_ALLOW_IMPORT=false
IMPORT_TOKEN=
WEB_PORT=8080
# Set production for shared deployments; startup then requires named access tokens.
APP_ENV=local
# JSON mapping tokens (32+ characters) to an actor and viewer/analyst/admin role.
WORKSPACE_ACCESS_TOKENS={}
