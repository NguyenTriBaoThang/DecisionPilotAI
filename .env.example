# Local Docker demo credentials. Set a different password when using a shared host.
POSTGRES_USER=decisionpilot
POSTGRES_PASSWORD=decisionpilot_local
POSTGRES_DB=decisionpilot
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_ALLOW_IMPORT=false
IMPORT_TOKEN=
WEB_PORT=8080
# Set production for shared deployments; startup then requires named access tokens.
APP_ENV=local
# JSON mapping tokens (32+ characters) to an actor and viewer/analyst/admin role.
WORKSPACE_ACCESS_TOKENS={}

# Enterprise Data Ingestion, Multimodal Processing & Object Storage
INGESTION_STORAGE_BACKEND=local
INGESTION_STORAGE_DIR=data/storage
INGESTION_MAX_FILE_BYTES=52428800
INGESTION_MAX_VIDEO_BYTES=157286400
INGESTION_MAX_AUDIO_BYTES=104857600
INGESTION_JOB_WORKERS=3
MULTIMODAL_VIDEO_MAX_FRAMES_CAP=20
MULTIMODAL_VIDEO_MAX_WIDTH=960
MULTIMODAL_MAX_PDF_PAGES=80
INGESTION_S3_BUCKET=
INGESTION_S3_ENDPOINT=
INGESTION_S3_REGION=ap-southeast-1

# Encryption, Signed Media URLs & Connector Security
# Generate a 32-byte url-safe base64 Fernet key in production (otherwise a local key is persisted under INGESTION_STORAGE_DIR)
INGESTION_ENCRYPTION_KEY=
INGESTION_SIGNING_SECRET=
CONNECTOR_ALLOW_PRIVATE_NETWORK=false
WHISPER_MODEL_SIZE=tiny

# Advanced RAG, Vector Store, Embedding & Text-to-SQL Copilot Configuration
# Embedding provider: auto | local | openai | gemini | huggingface
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Vector backend: sql (SQLite / PostgreSQL portable dense+sparse) | pgvector | qdrant
VECTOR_DB_BACKEND=sql
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=decisionpilot_rag_chunks

# RAG Chunking & Hybrid Retrieval Tuning
RAG_CHUNK_SIZE=720
RAG_CHUNK_OVERLAP=120
RAG_DENSE_TOP_K=12
RAG_BM25_TOP_K=12
RAG_DENSE_WEIGHT=0.52
RAG_BM25_WEIGHT=0.48
RAG_RERANK_TOP_K=6
RAG_MIN_RELEVANCE_SCORE=0.14
RAG_USE_LLM_RERANK=false

# Safe Text-to-SQL & Conversational Memory Limits
# Optional dedicated read-only DSN (falls back to main engine inside read_connection() READ ONLY guard)
READONLY_DATABASE_URL=
SQL_MAX_ROWS=50
SQL_TIMEOUT_SEC=8
CHAT_SHORT_TERM_TURNS=8
CHAT_MEMORY_TOKEN_BUDGET=2600
COPILOT_RATE_LIMIT_PER_MIN=45
